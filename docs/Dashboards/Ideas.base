filters:
  and:
    - type == "idea"
properties:
  id:
    displayName: ID
  file.name:
    displayName: Idea
  summary:
    displayName: Summary
  area:
    displayName: Area
  source:
    displayName: Source
  status:
    displayName: Status
  phase:
    displayName: Phase
  since:
    displayName: Since
  outcome:
    displayName: Outcome
  outcome_link:
    displayName: Went to
views:
  - type: table
    name: All open ideas
    filters:
      and:
        - status != "superseded"
    order:
      - id
      - file.name
      - area
      - status
      - phase
      - since
      - summary
    sort:
      - property: id
        direction: ASC
  - type: table
    name: Wanted soon
    filters:
      and:
        - status == "current"
        - phase == ""
    order:
      - id
      - file.name
      - area
      - since
      - summary
    sort:
      - property: id
        direction: ASC
  - type: table
    name: Planned or in progress
    filters:
      and:
        - status != "superseded"
        - phase != ""
    order:
      - id
      - file.name
      - area
      - status
      - phase
      - since
      - summary
    sort:
      - property: id
        direction: ASC
  - type: table
    name: Parked
    filters:
      and:
        - status == "draft"
        - phase == ""
    groupBy:
      property: area
      direction: ASC
    order:
      - id
      - file.name
      - status
      - since
      - summary
    sort:
      - property: id
        direction: ASC
  - type: table
    name: Done or dropped
    filters:
      and:
        - status == "superseded"
    order:
      - id
      - file.name
      - outcome
      - outcome_link
      - area
      - since
      - summary
    sort:
      - property: id
        direction: ASC
