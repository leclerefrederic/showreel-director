filters:
  and:
    - 'type == "decision"'
properties:
  id:
    displayName: ID
  file.name:
    displayName: Decision
  summary:
    displayName: Summary
  since:
    displayName: Since
  affects:
    displayName: Affects
  status:
    displayName: Status
views:
  - type: table
    name: "Current"
    filters:
      and:
        - 'status == "current"'
    order:
      - id
      - file.name
      - since
      - affects
      - summary
    sort:
      - property: since
        direction: DESC
  - type: table
    name: "Superseded"
    filters:
      and:
        - 'status == "superseded"'
    order:
      - id
      - file.name
      - since
      - affects
      - summary
