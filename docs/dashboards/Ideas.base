filters:
  and:
    - 'type == "idea"'
    - 'file.inFolder("Claude/ideas")'
formulas:
  stage: 'if(status == "superseded", "Done or dropped", if(phase, "Planned in " + phase, if(status == "current", "Wanted soon", "Parked")))'
properties:
  id:
    displayName: ID
  file.name:
    displayName: Idea
  summary:
    displayName: Summary
  area:
    displayName: Area
  source:
    displayName: Source
  phase:
    displayName: Phase
  since:
    displayName: Since
  outcome:
    displayName: Outcome
  outcome_link:
    displayName: Went to
  formula.stage:
    displayName: Stage
views:
  - type: table
    name: "Wanted soon"
    filters:
      and:
        - 'formula.stage == "Wanted soon"'
    order:
      - id
      - file.name
      - area
      - formula.stage
      - phase
      - since
      - summary
    sort:
      - property: since
        direction: DESC
  - type: table
    name: "Planned or in progress"
    filters:
      and:
        - 'formula.stage != "Wanted soon"'
        - 'formula.stage != "Parked"'
        - 'formula.stage != "Done or dropped"'
    order:
      - id
      - file.name
      - area
      - formula.stage
      - phase
      - since
      - summary
    sort:
      - property: since
        direction: DESC
  - type: table
    name: "Parked"
    filters:
      and:
        - 'formula.stage == "Parked"'
    groupBy:
      property: area
      direction: ASC
    order:
      - id
      - file.name
      - formula.stage
      - phase
      - since
      - summary
    sort:
      - property: id
        direction: ASC
  - type: table
    name: "Done or dropped"
    filters:
      and:
        - 'formula.stage == "Done or dropped"'
    order:
      - id
      - file.name
      - outcome
      - outcome_link
      - area
      - since
      - summary
    sort:
      - property: id
        direction: ASC
